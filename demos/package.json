{
  "name": "reqquest-demo",
  "version": "1.0.0",
  "description": "A demo service that pretends to facilitate a pet adoption process.",
  "type": "module",
  "scripts": {
    "start:nodemon": "nodemon",
    "build": "rm -rf dist && tsc",
    "start": "node --no-warnings --enable-source-maps ./dist/index.js",
    "keys:generate": "npm run keys:generate:api && npm run keys:generate:ui",
    "keys:check": "node ../api/dist/analysis/cli.js . --check-keys src/keys.generated.d.ts && node ../api/dist/analysis/cli.js . --check-keys ../ui/src/local/keys.generated.d.ts --module '@reqquest/ui' --groups Simple=src/simple,Default=src/default,Complex=src/complex,Rc=src/rc",
    "keys:generate:api": "node ../api/dist/analysis/cli.js . --emit-keys src/keys.generated.d.ts",
    "keys:generate:dev": "npm run keys:generate:api && if [ -f ../ui/src/local/keys.generated.d.ts ]; then npm run keys:generate:ui; else echo 'skipping UI keys - ../ui/src/local/keys.generated.d.ts is not mounted'; fi",
    "keys:generate:ui": "node ../api/dist/analysis/cli.js . --emit-keys ../ui/src/local/keys.generated.d.ts --module '@reqquest/ui' --groups Simple=src/simple,Default=src/default,Complex=src/complex,Rc=src/rc"
  },
  "dependencies": {
    "@reqquest/api": "file:../api",
    "@txstate-mws/graphql-server": "^2.3.2",
    "luxon": "^3.6.1"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^4.0.0",
    "@types/luxon": "^3.3.1",
    "@types/node": "^22.0.0",
    "eslint-config-love": "^119.0.0",
    "nodemon": "^3.1.9",
    "typescript": "^5.1.6"
  },
  "nodemonConfig": {
    "exec": "cd ../api && npm run build && cd ../demos && npm run keys:generate:dev && npm run build && node --no-warnings --enable-source-maps ./dist/index.js",
    "ext": "js,ts",
    "watch": [
      "/usr/app/demos/src",
      "/usr/app/api/src"
    ],
    "ignore": [
      "/usr/app/demos/src/keys.generated.d.ts",
      "/usr/app/ui/src/local/keys.generated.d.ts"
    ]
  }
}
