{
  "compilerOptions": {
    "target": "es2024",
    "module": "es2022",
    "types": ["node"],
    "moduleResolution": "node10",
    "declaration": true,
    "outDir": "./dist",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*"]
}
